            <button id="btn-delete-before" style="padding:3px 8px;background:rgba(243,139,168,.15);color:#f38ba8;border:none;border-radius:4px;font-size:11px;cursor:pointer" disabled title="Delete all sessions before the current one">&#128465; Delete Before</button>

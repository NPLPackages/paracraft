    var m = document.querySelector('meta[name="viewport"]');
    if(m) m.setAttribute('content','width=device-width, initial-scale=1.0');
    else { m = document.createElement('meta'); m.name='viewport'; m.content='width=device-width, initial-scale=1.0'; document.head.appendChild(m); }
})();

<script>
(function() {
    var _open = false;
    var _iframeReady = false;

    function openLogDrawer() {
        var drawer   = document.getElementById('log-drawer');
        var backdrop = document.getElementById('log-drawer-backdrop');
        var iframe   = document.getElementById('log-drawer-iframe');
        if (!_iframeReady) {
            _iframeReady = true;
            iframe.addEventListener('load', function() {
                try { iframe.contentWindow.postMessage({ type: 'refresh' }, '*'); } catch(e) {}
            });
            iframe.src = '/raw?file=script/apps/Aries/Creator/Game/Common/ChatLogDebugView.page';
        } else {
            try { iframe.contentWindow.postMessage({ type: 'refresh' }, '*'); } catch(e) {}
        }
        drawer.style.transform        = 'translateX(0)';
        backdrop.style.opacity        = '1';
        backdrop.style.pointerEvents  = 'auto';
        var btn = document.getElementById('btn-open-logs');
        if (btn) { btn.style.borderColor = '#89b4fa'; btn.style.color = '#89b4fa'; }
        _open = true;
    }

    function closeLogDrawer() {
        var drawer   = document.getElementById('log-drawer');
        var backdrop = document.getElementById('log-drawer-backdrop');
        drawer.style.transform        = 'translateX(100%)';
        backdrop.style.opacity        = '0';
        backdrop.style.pointerEvents  = 'none';
        var btn = document.getElementById('btn-open-logs');
        if (btn) { btn.style.borderColor = ''; btn.style.color = ''; }
        _open = false;
    }

    function toggleLogDrawer() {
        if (_open) closeLogDrawer(); else openLogDrawer();
    }

    window.openLogDrawer  = openLogDrawer;
    window.closeLogDrawer = closeLogDrawer;
    window.toggleLogDrawer = toggleLogDrawer;

    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && _open) closeLogDrawer();
    });
})();
</script>


            <div style="width:1px;height:18px;background:#45475a"></div>
            <button id="btn-refresh" style="padding:3px 8px;background:rgba(166,227,161,.15);color:#a6e3a1;border:none;border-radius:4px;font-size:11px;cursor:pointer" title="Reload file and jump to latest message">&#8635; Refresh</button>
            <button id="btn-delete-before" style="padding:3px 8px;background:rgba(243,139,168,.15);color:#f38ba8;border:none;border-radius:4px;font-size:11px;cursor:pointer" disabled title="Delete all messages before the current one">&#128465; Delete Before</button>
            <div style="width:1px;height:18px;background:#45475a"></div>
            <input id="search-box" type="text" placeholder="Search in message... (Ctrl+F)" style="background:#1a1a2e;color:#cdd6f4;border:1px solid #45475a;border-radius:4px;padding:3px 8px;font-size:11px;width:220px" />
            <div style="width:1px;height:18px;background:#45475a"></div>
            <button id="btn-vscode" style="padding:3px 8px;background:rgba(203,166,247,.15);color:#cba6f7;border:none;border-radius:4px;font-size:11px;cursor:pointer" disabled title="Open current session in VS Code">&#x1F4C2; VSCode</button>
            <span id="status-bar" style="font-size:11px;color:#6c7086;margin-left:auto;white-space:nowrap"></span>
        </div>

        <!-- Content area -->
        <div id="content-wrap" style="flex:1;overflow:auto;background:#1e1e2e">
            <div id="cl-content" class="md-view">
                <p style="color:#6c7086;text-align:center;padding:40px 0">Select a date and session to view.</p>
            </div>
        </div>
    </div>
</div>

<script>
(function(){
"use strict";

// ======================== State ========================
var logDir = "temp/aichat_logs/";
var files = [];
var currentFile = null;
var sessions = [];
var messages = [];
var currentMessageIdx = -1;
var currentStepIdx = -1;
var currentSteps = [];
var totalFileSize = 0;
var messageStepsCache = {};

// ======================== DOM refs ========================
var $dateInput    = document.getElementById("date-input");
var $btnPrevDay   = document.getElementById("btn-prev-day");
var $btnNextDay   = document.getElementById("btn-next-day");
var $fileInfo     = document.getElementById("file-info");
var $sessionCount = document.getElementById("session-count");
var $sessionList  = document.getElementById("session-list");
var $content      = document.getElementById("cl-content");
var $contentWrap  = document.getElementById("content-wrap");
var $btnPrev         = document.getElementById("btn-prev");
var $btnNext         = document.getElementById("btn-next");
var $btnRefresh      = document.getElementById("btn-refresh");
var $btnDeleteBefore = document.getElementById("btn-delete-before");
var $searchBox       = document.getElementById("search-box");
var $btnVSCode       = document.getElementById("btn-vscode");
var $statusBar       = document.getElementById("status-bar");

// ======================== Helpers ========================
function formatSize(n) {
    if (n > 1048576) return (n/1048576).toFixed(1) + " MB";
    if (n > 1024) return (n/1024).toFixed(0) + " KB";
    return n + " B";
}

function getLocalDateStr(d) {
    d = d || new Date();
    var pad = function(n){ return n < 10 ? "0" + n : n; };
    return d.getFullYear() + "-" + pad(d.getMonth() + 1) + "-" + pad(d.getDate());
}

function ajax(action, params, cb) {
    var qs = "action=" + action;
    if (params) for (var k in params) {
        if (params.hasOwnProperty(k)) qs += "&" + k + "=" + encodeURIComponent(params[k]);
    }
    var xhr = new XMLHttpRequest();
    xhr.open("POST", "/ajax/raw?file=script/apps/Aries/Creator/Game/Common/ChatLogDebugView.page", true);
    xhr.setRequestHeader("Content-Type", "application/x-www-form-urlencoded");
    xhr.onreadystatechange = function(){
        if (xhr.readyState === 4) {
            try { cb(JSON.parse(xhr.responseText)); }
            catch(e){ cb({error: xhr.statusText || "parse error"}); }
        }
    };
    xhr.send(qs);
}

function shiftDate(dateStr, days) {
    var d = new Date(dateStr + "T00:00:00");
    d.setDate(d.getDate() + days);
    return getLocalDateStr(d);
}

function formatEpoch(epoch) {
    if (!epoch) return "";
    var d = new Date(epoch * 1000);
    var pad = function(n){ return n < 10 ? "0" + n : n; };
    return pad(d.getHours()) + ":" + pad(d.getMinutes()) + ":" + pad(d.getSeconds());
}

function escapeHtml(str) {
    return str.replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;");
}

// ======================== File list ========================
function loadFileList(cb) {
    ajax("list_files", {}, function(data){
        files = data || [];
        if (cb) cb();
    });
}

function findFileByDate(dateStr) {
    for (var i = 0; i < files.length; i++) {
        if (files[i].date === dateStr) return files[i];
    }
    return null;
}

// ======================== Date navigation ========================
function selectDate(dateStr) {
    $dateInput.value = dateStr;
    var fileEntry = findFileByDate(dateStr);
    if (fileEntry) {
        $fileInfo.textContent = fileEntry.filename + " (" + formatSize(fileEntry.size) + ")";
        loadFileByName(fileEntry.filename);
    } else {
        $fileInfo.textContent = "No log file for " + dateStr;
        currentFile = null;
        sessions = [];
        messages = [];
        currentMessageIdx = -1;
        currentStepIdx = -1;
        currentSteps = [];
        messageStepsCache = {};
        $sessionCount.textContent = "Messages";
        $sessionList.innerHTML = '<div style="padding:12px;color:#6c7086;font-size:11px">No data for this date.</div>';
        $content.innerHTML = '<p style="color:#6c7086;text-align:center;padding:40px 0">No log file for ' + dateStr + '.</p>';
        $statusBar.textContent = "";
        updateNavButtons();
    }
}

$dateInput.addEventListener("change", function(){ selectDate($dateInput.value); });
$btnPrevDay.addEventListener("click", function(){ if ($dateInput.value) selectDate(shiftDate($dateInput.value, -1)); });
$btnNextDay.addEventListener("click", function(){ if ($dateInput.value) selectDate(shiftDate($dateInput.value, 1)); });

// ======================== Load file & messages ========================
function loadFileByName(fname) {
    if (currentFile === fname) return;
    currentFile = fname;
    currentMessageIdx = -1;
    currentStepIdx = -1;
    currentSteps = [];
    messageStepsCache = {};
    $sessionList.innerHTML = '<div style="text-align:center;padding:30px 0;color:#6c7086;font-size:13px">Scanning\u2026</div>';
    $content.innerHTML = '<p style="color:#6c7086;text-align:center;padding:40px 0">Loading\u2026</p>';
    $statusBar.textContent = "";

    ajax("get_sessions", {logfile: fname}, function(data){
        if (data.error) {
            $sessionList.innerHTML = '<div style="padding:12px;color:#f38ba8;font-size:11px">' + data.error + '</div>';
            return;
        }
        sessions = data.sessions || [];
        messages = data.messages || [];
        totalFileSize = data.fileSize || 0;
        $sessionCount.textContent = messages.length + " Messages";
        renderMessageList();

        if (messages.length > 0) {
            selectMessage(messages.length - 1);
        } else {
            $content.innerHTML = '<div style="color:#6c7086;text-align:center;padding:40px 0">No messages found.</div>';
        }
        $statusBar.textContent = messages.length + " messages (" + sessions.length + " sessions) | " + formatSize(totalFileSize);
    });
}

// ======================== Message list (sidebar) ========================
var messageDisplayOrder = [];

function renderMessageList() {
    messageDisplayOrder = [];
    for (var i = messages.length - 1; i >= 0; i--) messageDisplayOrder.push(i);

    var html = "";
    for (var di = 0; di < messageDisplayOrder.length; di++) {
        var i = messageDisplayOrder[di];
        var m = messages[i];
        var timeStr = formatEpoch(m.epoch);
        var preview = m.userPreview || "(no preview)";
        if (preview.length > 80) preview = preview.substring(0, 80) + "\u2026";

        var toolsHtml = "";
        

        html += '<div class="message-item" data-idx="' + i + '">';
        html += '<div class="msg-header" data-idx="' + i + '">';
        html += '<div style="display:flex;justify-content:space-between;align-items:flex-start">';
        html += '<span style="font-size:11px">\uD83D\uDCAC</span>';
        html += '<span style="color:#6c7086;font-size:10px;flex-shrink:0;margin-left:6px">';
        html += (timeStr || '') + (m.sessionCount > 1 ? ' \u00b7 ' + m.sessionCount + ' reqs' : '');
        html += '</span></div>';
        html += '<div class="msg-preview">' + escapeHtml(preview) + '</div>';
        html += toolsHtml;
        html += '</div>'; // end msg-header
        html += '<div class="msg-children" data-msg="' + i + '"></div>';
        html += '</div>'; // end message-item
    }
    $sessionList.innerHTML = html || '<div style="padding:12px;color:#6c7086;font-size:11px">No messages.</div>';

    // Bind click on msg-header elements
    var headers = $sessionList.querySelectorAll(".msg-header");
    for (var di = 0; di < headers.length; di++) {
        (function(header) {
            var idx = parseInt(header.getAttribute("data-idx"));
            header.style.cursor = "pointer";
            header.addEventListener("click", function(){ selectMessage(idx); });
            header.addEventListener("mouseenter", function(){
                var item = header.parentElement;
                if (!item.classList.contains("msg-active")) item.style.background = "#2a2a3e";
            });
            header.addEventListener("mouseleave", function(){
                var item = header.parentElement;
                if (!item.classList.contains("msg-active")) item.style.background = "";
            });
        })(headers[di]);
    }
}

// ======================== Select message ========================
function selectMessage(idx) {
    if (idx < 0 || idx >= messages.length) return;

    // Collapse previous message's step children
    if (currentMessageIdx >= 0 && currentMessageIdx !== idx) {
        collapseMessage(currentMessageIdx);
    }

    currentMessageIdx = idx;
    currentStepIdx = -1;
    updateNavButtons();

    // Highlight message in sidebar
    var allItems = $sessionList.querySelectorAll(".message-item");
    for (var i = 0; i < allItems.length; i++) {
        var itemIdx = parseInt(allItems[i].getAttribute("data-idx"));
        if (itemIdx === idx) {
            allItems[i].style.background = "#294670";
            allItems[i].style.borderLeftColor = "#89b4fa";
            allItems[i].classList.add("msg-active");
        } else {
            allItems[i].style.background = "";
            allItems[i].style.borderLeftColor = "transparent";
            allItems[i].classList.remove("msg-active");
        }
    }

    // Check cache
    if (messageStepsCache[idx]) {
        expandAndSelectFirst(idx, messageStepsCache[idx]);
        return;
    }

    // Load message text, parse steps
    $content.innerHTML = '<div style="color:#6c7086;text-align:center;padding:40px 0">Loading\u2026</div>';
    $statusBar.textContent = "Loading...";
    var m = messages[idx];

    loadMessageText(m, function(text) {
        var steps = parseSteps(text);
        messageStepsCache[idx] = steps;
        expandAndSelectFirst(idx, steps);
    });
}

function expandAndSelectFirst(msgIdx, steps) {
    currentSteps = steps;
    renderStepChildren(msgIdx, steps);

    // Find first meaningful step (skip unknown)
    var firstStepIdx = -1;
    for (var i = 0; i < steps.length; i++) {
        if (steps[i].type !== "unknown") {
            firstStepIdx = i;
            break;
        }
    }
    if (firstStepIdx >= 0) {
        selectStep(firstStepIdx);
    } else {
        $content.innerHTML = '<p style="color:#6c7086;text-align:center;padding:40px 0">No content.</p>';
    }
    var m = messages[msgIdx];
    $statusBar.textContent = "Message #" + m.id + " | " + m.sessionCount + " request(s) | " + steps.length + " steps";
}

function collapseMessage(idx) {
    if (idx < 0) return;
    var container = document.querySelector('.msg-children[data-msg="' + idx + '"]');
    if (container) {
        container.classList.remove("expanded");
        container.innerHTML = "";
    }
}

function renderStepChildren(msgIdx, steps) {
    var container = document.querySelector('.msg-children[data-msg="' + msgIdx + '"]');
    if (!container) return;

    var html = "";
    var reqNum = 0;
    for (var i = 0; i < steps.length; i++) {
        var step = steps[i];
        if (step.type === "unknown") continue;

        var icon = "", label = "", meta = "", cls = "";
        if (step.type === "request") {
            reqNum++;
            icon = "\uD83D\uDD04";
            label = "Request #" + reqNum + (reqNum > 1 ? " (follow-up)" : "");
            meta = (step.meta.model || "");
            if (step.meta.toolCount) meta += (meta ? " \u00b7 " : "") + step.meta.toolCount + " tools";
            cls = "si-request";
        } else if (step.type === "response") {
            var isLast = true;
            for (var j = i + 1; j < steps.length; j++) { if (steps[j].type === "request") { isLast = false; break; } }
            var hasTC = parseInt(step.meta.toolCallCount || "0") > 0;
            icon = (isLast && !hasTC) ? "\u2705" : "\uD83E\uDD16";
            label = "Response #" + reqNum;
            var code = step.meta.resultCode || "?";
            meta = code;
            if (step.meta.duration) meta += " \u00b7 " + step.meta.duration;
            if (hasTC) meta += " \u00b7 \uD83D\uDD27\u00d7" + step.meta.toolCallCount;
            cls = "si-response";
        } else if (step.type === "tool-call") {
            icon = "\uD83D\uDD27";
            label = step.name || step.callId;
            meta = step.callId ? step.callId.substring(0, 20) : "";
            cls = "si-tool";
        } else if (step.type === "tool-inline") {
            icon = step.toolStatus === "success" ? "\u2705" : step.toolStatus === "error" ? "\u274C" : "\u23F3";
            label = step.name || "tool";
            meta = step.duration || "";
            if (step.toolStatus === "error") meta = "error" + (meta ? " \u00b7 " + meta : "");
            cls = "si-tool";
        }

        html += '<div class="step-item ' + cls + '" data-step="' + i + '">';
        html += '<span class="si-icon">' + icon + '</span>';
        html += '<span class="si-label">' + escapeHtml(label) + '</span>';
        html += '<span class="si-meta">' + escapeHtml(meta) + '</span>';
        html += '</div>';
    }

    container.innerHTML = html;
    container.classList.add("expanded");

    // Attach click listeners
    var items = container.querySelectorAll(".step-item");
    for (var i = 0; i < items.length; i++) {
        (function(item) {
            item.addEventListener("click", function(e) {
                e.stopPropagation();
                selectStep(parseInt(item.getAttribute("data-step")));
            });
        })(items[i]);
    }

    // Scroll message into view
    var msgItem = document.querySelector('.message-item[data-idx="' + msgIdx + '"]');
    if (msgItem) msgItem.scrollIntoView({block: "nearest"});
}

// ======================== Select step ========================
function selectStep(stepIdx) {
    if (stepIdx < 0 || stepIdx >= currentSteps.length) return;
    currentStepIdx = stepIdx;

    // Highlight in sidebar
    var allStepItems = $sessionList.querySelectorAll(".step-item");
    for (var i = 0; i < allStepItems.length; i++) {
        allStepItems[i].classList.remove("step-active");
    }
    var activeItem = document.querySelector('.step-item[data-step="' + stepIdx + '"]');
    if (activeItem) {
        activeItem.classList.add("step-active");
        activeItem.scrollIntoView({block: "nearest"});
    }

    // Render step content in right panel
    var step = currentSteps[stepIdx];
    if (step) {
        renderStepContent(step);
    }
}

function renderStepContent(step) {
    var html = '<div class="step-content-wrap"><div class="entry-block">';
    html += renderBlockContent(step.raw);
    html += '</div></div>';
    $content.innerHTML = html;
    $contentWrap.scrollTop = 0;

    // Copy-on-click for code blocks
    var pres = $content.querySelectorAll("pre.code-block");
    for (var i = 0; i < pres.length; i++) {
        pres[i].title = "Click to copy";
        pres[i].style.cursor = "pointer";
        pres[i].addEventListener("click", copyPre);
    }
}

function parseSteps(text) {
    var blocks = splitBlocks(text);
    var steps = [];
    for (var i = 0; i < blocks.length; i++) {
        var s = classifyBlock(blocks[i]);
        if (s) steps.push(s);
    }
    return steps;
}

function loadMessageText(message, cb) {
    var chunkSize = 2 * 1024 * 1024;
    if (message.totalLength <= chunkSize) {
        ajax("get_chunk", {logfile: currentFile, from: message.firstOffset, length: message.totalLength}, function(data){
            cb(data.text || "");
        });
    } else {
        var parts = [];
        var loaded = 0;
        var total = message.totalLength;
        (function loadNext() {
            var len = Math.min(chunkSize, total - loaded);
            ajax("get_chunk", {logfile: currentFile, from: message.firstOffset + loaded, length: len}, function(data){
                parts.push(data.text || "");
                loaded += data.length;
                if (loaded < total) loadNext();
                else cb(parts.join(""));
            });
        })();
    }
}

// ======================== Render Helpers ========================
function renderMdContent(text) {
    text = text.replace(/\r/g, '');
    var parts = text.split(/(\[Image:[^\]]+\])/g);
    var out = [];
    for (var i = 0; i < parts.length; i++) {
        var m = parts[i].match(/^\[Image:\s*(.*?)\]$/);
        if (m) {
            var safeUrl = escapeHtml(m[1].trim());
            out.push('<img src="' + safeUrl + '" style="max-width:100%;max-height:400px;display:block;margin:6px 0;border-radius:4px"><div style="font-size:11px;color:#6c7086;word-break:break-all;margin-bottom:6px">' + safeUrl + '</div>');
        } else {
            out.push(escapeHtml(parts[i]));
        }
    }
    return out.join("");
}

function roleClass(role) {
    var r = role.toLowerCase();
    if (r === "system") return "role-system";
    if (r === "user") return "role-user";
    if (r.indexOf("assistant") !== -1) return r.indexOf("think") !== -1 ? "role-thinking" : "role-assistant";
    if (r.indexOf("tool") !== -1) return "role-tool";
    return "";
}

function copyPre(e) {
    var text = e.currentTarget.textContent;
    try { navigator.clipboard.writeText(text); } catch(ex) {}
    var old = e.currentTarget.style.outline;
    e.currentTarget.style.outline = "1px solid #a6e3a1";
    setTimeout(function(){ e.currentTarget.style.outline = old; }, 600);
}

// ======================== Message View (Tree) ========================
// Split text by --- separators (outside fences)
function splitBlocks(text) {
    var lines = text.replace(/\r/g, '').split("\n");
    var blocks = [];
    var current = [];
    var inFence = false;
    for (var i = 0; i < lines.length; i++) {
        var line = lines[i];
        if (/^~~~/.test(line) || /^```/.test(line)) {
            inFence = !inFence;
            current.push(line);
        } else if (!inFence && /^---\s*$/.test(line)) {
            if (current.length) blocks.push(current.join("\n"));
            current = [];
        } else {
            current.push(line);
        }
    }
    if (current.length) blocks.push(current.join("\n"));
    return blocks;
}

// Classify a block by its type
function classifyBlock(block) {
    var result = {raw: block.trim()};
    if (!result.raw) return null;

    // # Tool Call block
    if (/^# Tool Call/m.test(result.raw)) {
        result.type = "tool-call";
        var idMatch = result.raw.match(/^# Tool Call - (.+)/m);
        result.callId = idMatch ? idMatch[1].trim() : "";
        var nameMatch = result.raw.match(/^name\s+:\s+(.+)/m);
        result.name = nameMatch ? nameMatch[1].trim() : result.callId;
        result.meta = {};
        return result;
    }

    // Parse metadata from ~~~ block
    result.meta = {};
    var metaBlock = result.raw.match(/~~~\n([\s\S]*?)~~~/);
    if (metaBlock) {
        metaBlock[1].split("\n").forEach(function(ml) {
            var kv = ml.match(/^([\w\-]+)\s+:\s+(.+)/);
            if (kv) result.meta[kv[1].trim()] = kv[2].trim();
        });
    }
    var typeMatch = result.raw.match(/^type\s+:\s+(\w+)/m);

    // # Session header - may also contain a request
    if (/^# Session/m.test(result.raw)) {
        var sm = result.raw.match(/^# Session - (\d+)/m);
        result.sessionId = sm ? sm[1] : "";
        if (typeMatch) {
            result.type = typeMatch[1]; // "request" or "response"
            result.hasSessionHeader = true;
        } else {
            result.type = "unknown"; // pure session header with no type
        }
        return result;
    }

    // Standalone metadata block with type
    if (typeMatch) {
        result.type = typeMatch[1]; // "request" or "response"
        return result;
    }

    // Inline tool call markers (⏳ Calling / ✓ result / ✗ error from LogToolCallStart/End)
    if (/^[\u23F3\u2713\u2717]\s*\*\*/m.test(result.raw)) {
        result.type = "tool-inline";
        // Extract tool name from `tool_name` or **tool_name**
        var tnMatch = result.raw.match(/`([^`]+)`/) || result.raw.match(/\*\*(?:Calling\*\*\s*`([^`]+)`|([^\*]+)\*\*)/);
        result.name = (tnMatch && (tnMatch[1] || tnMatch[2] || tnMatch[3])) || "tool";
        result.name = result.name.replace(/^\s+|\s+$/g, "");
        // Detect completion status
        result.toolStatus = /^\u2713/m.test(result.raw) ? "success" : /^\u2717/m.test(result.raw) ? "error" : "pending";
        // Extract duration if present
        var durMatch = result.raw.match(/\((\d+)ms\)/);
        result.duration = durMatch ? durMatch[1] + "ms" : "";
        result.meta = {};
        return result;
    }

    result.type = "unknown";
    return result;
}

// Render raw block content (reuses the original block renderer logic)
function renderBlockContent(block) {
    block = (block || "").replace(/\r/g, '');
    var lines = block.split("\n");
    var li = 0;
    var html = '';

    function peek() { return li < lines.length ? lines[li] : null; }
    function next() { return li < lines.length ? lines[li++] : null; }

    while (li < lines.length) {
        var line = peek();
        if (line === null) break;

        // # heading
        if (/^# /.test(line)) {
            next();
            html += '<h1 class="session-title">' + escapeHtml(line.slice(2)) + '</h1>';
            continue;
        }
        // ## heading
        if (/^## /.test(line)) {
            next();
            html += '<h2 class="section-head">' + escapeHtml(line.slice(3)) + '</h2>';
            continue;
        }
        // ### heading (role)
        if (/^### /.test(line)) {
            next();
            var role = line.slice(4);
            html += '<h3 class="msg-role ' + roleClass(role) + '">' + escapeHtml(role) + '</h3>';
            continue;
        }
        // ~~~ fenced code block
        if (/^~~~/.test(line)) {
            var fence = next();
            var isMd = /md/i.test(fence);
            var isMeta = fence.trim() === "~~~";
            var codeLines = [];
            while (li < lines.length && !/^~~~/.test(peek())) codeLines.push(next());
            if (li < lines.length) next();
            if (isMd) {
                html += '<div class="md-rendered">' + renderMdContent(codeLines.join("\n")) + '</div>';
            } else {
                var cls = "code-block" + (isMeta ? " meta-block" : "") + (/json/i.test(fence) ? " json-block" : "");
                html += '<pre class="' + cls + '">' + escapeHtml(codeLines.join("\n")) + '</pre>';
            }
            continue;
        }
        // ``` fenced
        if (/^```/.test(line)) {
            var fence2 = next();
            var codeLines2 = [];
            while (li < lines.length && !/^```/.test(peek())) codeLines2.push(next());
            if (li < lines.length) next();
            html += '<pre class="code-block' + (/json/i.test(fence2) ? ' json-block' : '') + '">' + escapeHtml(codeLines2.join("\n")) + '</pre>';
            continue;
        }
        // <details> block
        if (/^<details>/.test(line)) {
            var detLines = [];
            while (li < lines.length) {
                var dl = next();
                detLines.push(dl);
                if (/<\/details>/.test(dl)) break;
            }
            var detRaw = detLines.join("\n");
            var summaryMatch = detRaw.match(/<summary>([\s\S]*?)<\/summary>/);
            var summaryText = summaryMatch ? summaryMatch[1] : "Details";
            var bodyRaw = detRaw.replace(/<details>/, "").replace(/<\/details>/, "").replace(/<summary>[\s\S]*?<\/summary>/, "").trim();
            var bodyHtml = "";
            var bLines = bodyRaw.split("\n");
            var bi2 = 0;
            while (bi2 < bLines.length) {
                if (/^```/.test(bLines[bi2])) {
                    var f3 = bLines[bi2++];
                    var cl3 = [];
                    while (bi2 < bLines.length && !/^```/.test(bLines[bi2])) cl3.push(bLines[bi2++]);
                    if (bi2 < bLines.length) bi2++;
                    bodyHtml += '<pre class="code-block' + (/json/i.test(f3) ? ' json-block' : '') + '">' + escapeHtml(cl3.join("\n")) + '</pre>';
                } else {
                    if (bLines[bi2].trim()) bodyHtml += '<div class="det-body">' + escapeHtml(bLines[bi2]) + '</div>';
                    bi2++;
                }
            }
            html += '<details><summary>' + escapeHtml(summaryText) + '</summary>' + bodyHtml + '</details>';
            continue;
        }
        // Tool status lines
        if (/^[\u23F3\u2713\u2717]/.test(line)) {
            next();
            var colored = line.replace(/^\u23F3/, '<span style="color:#f9e2af">\u23F3</span>')
                              .replace(/^\u2713/, '<span style="color:#a6e3a1">\u2713</span>')
                              .replace(/^\u2717/, '<span style="color:#f38ba8">\u2717</span>')
                              .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
                              .replace(/`([^`]+)`/g, '<code style="background:#2a2a3e;padding:0 3px;border-radius:3px">$1</code>');
            html += '<div class="tool-line">' + colored + '</div>';
            continue;
        }
        next(); // skip blank/unknown
    }
    return html;
}

// ======================== Navigation ========================
function updateNavButtons() {
    $btnPrev.disabled = currentMessageIdx <= 0;
    $btnNext.disabled = currentMessageIdx >= messages.length - 1;
    $btnDeleteBefore.disabled = currentMessageIdx <= 0;
    $btnVSCode.disabled = currentMessageIdx < 0 || !currentFile;
}

$btnPrev.addEventListener("click", function(){ selectMessage(currentMessageIdx - 1); });
$btnNext.addEventListener("click", function(){ selectMessage(currentMessageIdx + 1); });

// ======================== Refresh ========================
$btnRefresh.addEventListener("click", function(){
    var fname = currentFile;
    if (!fname) {
        loadFileList(function(){
            var today = getLocalDateStr();
            if (!findFileByDate(today) && files.length > 0) today = files[0].date;
            selectDate(today);
        });
        return;
    }
    $statusBar.textContent = "Refreshing\u2026";
    currentFile = null;
    messageStepsCache = {};
    loadFileList(function(){
        var entry = null;
        for (var i = 0; i < files.length; i++) { if (files[i].filename === fname) { entry = files[i]; break; } }
        if (entry) $fileInfo.textContent = entry.filename + " (" + formatSize(entry.size) + ")";
        loadFileByName(fname);
    });
});

// ======================== Open in VS Code ========================
$btnVSCode.addEventListener("click", function(){
    if (currentMessageIdx < 0 || !currentFile) return;
    var m = messages[currentMessageIdx];
    ajax("open_in_vscode", {filepath: logDir + currentFile, line: m.firstLine}, function(data){
        if (data.error) alert("VSCode error: " + data.error);
    });
});

// ======================== Delete Before ========================
$btnDeleteBefore.addEventListener("click", function(){
    if (currentMessageIdx <= 0 || !currentFile) return;
    var m = messages[currentMessageIdx];
    var count = currentMessageIdx;
    if (!confirm("Delete " + count + " message(s) before this one?\nThis cannot be undone.")) return;
    $statusBar.textContent = "Deleting\u2026";
    $btnDeleteBefore.disabled = true;
    ajax("delete_before", {logfile: currentFile, from: m.firstOffset}, function(data){
        if (data.error) { alert("Error: " + data.error); $statusBar.textContent = "Delete failed."; updateNavButtons(); return; }
        $statusBar.textContent = "Deleted. Refreshing\u2026";
        var fname = currentFile;
        currentFile = null;
        messageStepsCache = {};
        loadFileList(function(){
            var entry = null;
            for (var i = 0; i < files.length; i++) { if (files[i].filename === fname) { entry = files[i]; break; } }
            if (entry) $fileInfo.textContent = entry.filename + " (" + formatSize(entry.size) + ")";
            loadFileByName(fname);
        });
    });
});

// ======================== Search ========================
var searchTimeout = null;
$searchBox.addEventListener("input", function(){
    if (searchTimeout) clearTimeout(searchTimeout);
    searchTimeout = setTimeout(doSearch, 300);
});
$searchBox.addEventListener("keydown", function(e){
    if (e.key === "Enter") { e.preventDefault(); doSearch(); }
});

function doSearch() {
    var query = $searchBox.value.trim();
    var old = $content.querySelectorAll(".search-hl");
    for (var i = 0; i < old.length; i++) {
        var p = old[i].parentNode;
        p.replaceChild(document.createTextNode(old[i].textContent), old[i]);
        p.normalize();
    }
    if (!query) {
        if (currentMessageIdx >= 0) {
            var m = messages[currentMessageIdx];
            $statusBar.textContent = "Message #" + m.id + " | " + m.sessionCount + " request(s)";
        }
        return;
    }
    var walker = document.createTreeWalker($content, NodeFilter.SHOW_TEXT, null, false);
    var node, matches = [], queryLower = query.toLowerCase();
    while (node = walker.nextNode()) {
        var text = node.textContent, startIdx = 0, idx;
        while ((idx = text.toLowerCase().indexOf(queryLower, startIdx)) !== -1) {
            matches.push({node: node, idx: idx});
            startIdx = idx + 1;
        }
    }
    var limit = Math.min(matches.length, 1000);
    for (var i = limit - 1; i >= 0; i--) {
        var mt = matches[i];
        var curIdx = mt.node.textContent.toLowerCase().indexOf(queryLower, mt.idx > 0 ? mt.idx : 0);
        if (curIdx === -1) continue;
        try {
            var range = document.createRange();
            range.setStart(mt.node, curIdx);
            range.setEnd(mt.node, curIdx + query.length);
            var span = document.createElement("span");
            span.className = "search-hl";
            range.surroundContents(span);
        } catch(e) {}
    }
    var first = $content.querySelector(".search-hl");
    if (first) { first.classList.add("search-hl-current"); first.scrollIntoView({behavior:"smooth", block:"center"}); }
    $statusBar.textContent = matches.length + " matches" + (matches.length > 1000 ? " (showing 1000)" : "");
}

// ======================== Keyboard ========================
document.addEventListener("keydown", function(e){
    if ((e.ctrlKey || e.metaKey) && e.key === "f") { e.preventDefault(); $searchBox.focus(); $searchBox.select(); }
    if (e.target.tagName !== "INPUT" && e.target.tagName !== "SELECT" && e.target.tagName !== "TEXTAREA") {
        if (e.key === "ArrowUp") { e.preventDefault(); selectMessage(currentMessageIdx - 1); }
        if (e.key === "ArrowDown") { e.preventDefault(); selectMessage(currentMessageIdx + 1); }
        if (e.key === "ArrowLeft") { e.preventDefault(); if (currentStepIdx > 0) selectStep(currentStepIdx - 1); }
        if (e.key === "ArrowRight") { e.preventDefault(); if (currentStepIdx < currentSteps.length - 1) selectStep(currentStepIdx + 1); }
    }
});

// ======================== postMessage API ========================
window.addEventListener("message", function(e) {
    if (!e.data || e.data.type !== "refresh") return;
    currentFile = null;
    messageStepsCache = {};
    var dateToReload = $dateInput.value || getLocalDateStr();
    loadFileList(function() {
        if (!findFileByDate(dateToReload) && files.length > 0) dateToReload = files[0].date;
        selectDate(dateToReload);
    });
});

// ======================== Init ========================
loadFileList(function(){
    var today = getLocalDateStr();
    if (!findFileByDate(today) && files.length > 0) today = files[0].date;
    selectDate(today);
});

})();
</script>

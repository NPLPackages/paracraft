<?npl
-- URL: http://localhost:8099/raw?file=script/apps/Aries/Creator/Game/Tasks/EasyBuilder/Copilot/bg_agent.page
-- page layout (must be on top)
PAGE_NO_HEADER = true; 
PAGE_NO_SIDE_BAR = true;
--[[
Title: Background Agent Debugger
Author: LiXizhi
Date: 2026/2/19
Desc: Web-based debugger UI for BackgroundAgent.
  Most UI and logic is in bg_agent.js.
  WebSocket endpoint: ws://<host>/ajax/raw?file=script/apps/Aries/Creator/Game/Tasks/EasyBuilder/Copilot/bg_agent.page&action=handshake
  Legacy AJAX endpoint: /ajax/raw?file=script/apps/Aries/Creator/Game/Tasks/EasyBuilder/Copilot/bg_agent.page&action=<action_name> (still available)
]]

if(is_ajax()) then
    NPL.load("(gl)script/apps/Aries/Creator/Game/Tasks/EasyBuilder/Copilot/BackgroundAgent.lua");
    local BackgroundAgent = commonlib.gettable("MyCompany.Aries.Game.Tasks.EasyBuilder.Copilot.BackgroundAgent");
    local agent = BackgroundAgent:GetInstance();

    -- Reject all AJAX calls if the game world is not yet fully loaded.
    local GameLogic = commonlib.gettable("MyCompany.Aries.Game.GameLogic");
    if not GameLogic or not GameLogic.IsRegionLoadedFired then
        wp_send_json({error = "game not ready"}, true);
        return;
    end

    -----------------------------------------------------------
    -- WebSocket handshake  (action=handshake)
    -----------------------------------------------------------
    add_action('wp_ajax_handshake', function()
        NPL.load("(gl)script/ide/System/Encoding/sha1.lua");
        local Encoding = commonlib.gettable("System.Encoding");

        local key = request:header("Sec-WebSocket-Key");
        if not key or key == "" then
            response:status(400):send("missing Sec-WebSocket-Key");
            return;
        end

        key = key .. "258EAFA5-E914-47DA-95CA-C5AB0DC85B11";
        key = Encoding.sha1(key, "base64");

        response.headers = {};
        response:add_header("status", "101 Switching Protocols");
        response:set_header("Connection", "Upgrade");
        response:set_header("Upgrade", "websocket");
        response:set_header("Sec-WebSocket-Accept", key);
        response:send_headers();

        local tid = request.nid;
        NPL.load("(gl)script/ide/System/os/network/WebSocket/WebSocketServer.lua");
        local WebSocketServer = commonlib.gettable("System.os.network.WebSocketServer");

        local nid = "ws_bgagent_" .. tostring(tid);
        WebSocketServer:AddClient(tid, nid);

        -- Send initial snapshot of agent state to the new client.
        -- NPL.load returns the exported module table (BgAgentWS singleton).
        local BgAgentWS = NPL.load("(gl)script/apps/Aries/Creator/Game/Tasks/EasyBuilder/Copilot/bg_agent_ws_server.lua");
        if BgAgentWS and BgAgentWS.HandleConnect then
            BgAgentWS:HandleConnect(nid);
        end
    end)

    NPL.load("(gl)script/apps/Aries/Creator/Game/Tasks/EasyBuilder/Copilot/BackgroundAgent.lua");
    local BackgroundAgent = commonlib.gettable("MyCompany.Aries.Game.Tasks.EasyBuilder.Copilot.BackgroundAgent");

    -- Helper: get singleton instance (may be nil if not yet created)
    local function GetAgent()
        return BackgroundAgent:GetInstance();
    end

    -----------------------------------------------------------
    -- Polling / status
    -----------------------------------------------------------
    add_action('wp_ajax_get_status', function()
        local agent = GetAgent();
        local ttsStatus = agent:GetTTSQueueStatus();
        local status = {
            playbackState    = agent:GetPlaybackState(),
            debugEnabled     = agent:IsDebugEnabled(),
            stepInProgress   = agent:IsStepInProgress(),
            isEnabled        = agent:IsEnabled(),
            isObservationMode = agent:IsObservationMode(),
            autoSpeakEnabled = agent:IsAutoSpeakEnabled(),
            isTTSPlaying     = ttsStatus and ttsStatus.isPlaying or false,
            hasTask          = agent:GetPrimaryLearningTask() ~= nil,
            chatCount        = agent:GetChatMessageCount(),
            llmCount         = agent:GetLLMHistoryCount(),
            voicePending     = agent:GetPendingVoiceCount(),
            tts              = ttsStatus,
            uiToolQueue      = agent:GetUIToolQueueStatus(),
        };
        do
            NPL.load("(gl)script/apps/Aries/Creator/Game/Tasks/EasyBuilder/Copilot/SceneVisionManager.lua");
            local SVM = commonlib.gettable("MyCompany.Aries.Game.Tasks.EasyBuilder.Copilot.SceneVisionManager");
            status.sceneVisionPassiveMode = SVM.passiveMode or false;
        end
        local task = agent:GetPrimaryLearningTask();
        if task then
            status.taskId   = task.id;
            status.taskText = task.text;
        end
        local progress = agent:GetLearningProgress();
        if progress then
            status.learningPercentage = progress.learningPercentage;
            status.totalAttempts      = progress.totalAttempts;
            status.totalCorrect       = progress.totalCorrect;
        end
        wp_send_json(status, true);
    end)

    -----------------------------------------------------------
    -- Playback controls
    -----------------------------------------------------------
    add_action('wp_ajax_play', function()
        local agent = GetAgent();
        agent:Play();
        wp_send_json({success = true, state = agent:GetPlaybackState()}, true);
    end)

    add_action('wp_ajax_pause', function()
        local agent = GetAgent();
        agent:Pause();
        wp_send_json({success = true, state = agent:GetPlaybackState()}, true);
    end)

    add_action('wp_ajax_stop', function()
        local agent = GetAgent();
        agent:Stop();
        wp_send_json({success = true, state = agent:GetPlaybackState()}, true);
    end)

    add_action('wp_ajax_step', function()
        local agent = GetAgent();
        agent:Step();
        wp_send_json({success = true, stepping = true}, true);
    end)

    -----------------------------------------------------------
    -- Chat history
    -----------------------------------------------------------
    add_action('wp_ajax_get_chat_history', function()
        local agent = GetAgent();
        local msgs = agent:GetChatMessageHistory() or {};
        local out = {};
        for i, m in ipairs(msgs) do
            out[#out+1] = {role = m.role, content = m.content, timestamp = m.timestamp, isComplete = m.isComplete};
        end
        wp_send_json({messages = out}, true);
    end)

    add_action('wp_ajax_send_message', function()
        local text = request:get("text");
        if not text or text == "" then
            wp_send_json({error = "empty message"}, true);
            return;
        end
        local agent = GetAgent();
        agent.waitingForUserReply = false;
        agent.waitingForUserReplyStartTime = nil;
        agent:ProcessWithLLM(text, function(result)
            -- response already sent; result processed asynchronously
        end);
        wp_send_json({success = true, queued = true}, true);
    end)

    -----------------------------------------------------------
    -- LLM call history
    -----------------------------------------------------------
    add_action('wp_ajax_get_llm_history', function()
        local agent = GetAgent();
        local count = agent:GetLLMHistoryCount();
        local maxEntries = tonumber(request:get("max")) or 20;
        local entries = {};
        for i = 1, math.min(count, maxEntries) do
            local e = agent:GetFormattedLLMEntry(i);
            if e then entries[#entries+1] = e; end
        end
        wp_send_json({count = count, entries = entries}, true);
    end)

    -----------------------------------------------------------
    -- Context history (scene vision + voice combined)
    -----------------------------------------------------------
    add_action('wp_ajax_get_context_history', function()
        local agent = GetAgent();
        local maxEntries = tonumber(request:get("max")) or 20;
        local entries = agent:GetFormattedContextHistory(maxEntries);
        wp_send_json({entries = entries or {}}, true);
    end)

    -----------------------------------------------------------
    -- Learning progress
    -----------------------------------------------------------
    add_action('wp_ajax_get_learning_progress', function()
        local agent = GetAgent();
        local progress = agent:GetLearningProgress();
        local summary  = agent:GetLearningProgressSummary();
        wp_send_json({progress = progress, summary = summary}, true);
    end)

    -----------------------------------------------------------
    -- Discovered copilots
    -----------------------------------------------------------
    add_action('wp_ajax_get_copilots', function()
        local agent = GetAgent();
        local copilots = agent:GetDiscoveredCopilots() or {};
        local out = {};
        for _, c in ipairs(copilots) do
            out[#out+1] = {name = c.name, displayName = c.displayName, toolCount = c.tools and #c.tools or 0};
        end
        wp_send_json({copilots = out}, true);
    end)

    -----------------------------------------------------------
    -- Registered tools
    -----------------------------------------------------------
    add_action('wp_ajax_get_tools', function()
        local agent = GetAgent();
        local defs = agent:GetAllToolDefinitions() or {};
        wp_send_json({tools = defs}, true);
    end)

    -----------------------------------------------------------
    -- User profile
    -----------------------------------------------------------
    add_action('wp_ajax_get_user_profile', function()
        local agent = GetAgent();
        wp_send_json({profile = agent:GetUserProfile()}, true);
    end)

    add_action('wp_ajax_set_user_profile', function()
        local agent = GetAgent();
        local age  = tonumber(request:get("age"));
        local name = request:get("name");
        local primary   = request:get("primaryLanguage");
        local secondary = request:get("secondaryLanguage");
        agent:SetUserProfile({age = age, name = name, primaryLanguage = primary, secondaryLanguage = secondary});
        wp_send_json({success = true, profile = agent:GetUserProfile()}, true);
    end)

    -----------------------------------------------------------
    -- Primary learning task
    -----------------------------------------------------------
    add_action('wp_ajax_set_task', function()
        local text = request:get("text");
        local soul = request:get("soul");
        local sop = request:get("sop");
        local agent = GetAgent();
        local options = {};
        if soul and soul ~= "" then options.soul = soul; end
        if sop and sop ~= "" then options.sop = sop; end
        agent:SetPrimaryLearningTask(text, options);
        wp_send_json({success = true}, true);
    end)

    -----------------------------------------------------------
    -- Dialog debug info
    -----------------------------------------------------------
    add_action('wp_ajax_get_dialog_debug', function()
        local agent = GetAgent();
        local info = agent:GetDialogDebugInfo();
        wp_send_json({info = info or {}}, true);
    end)

    -----------------------------------------------------------
    -- System prompt
    -----------------------------------------------------------
    add_action('wp_ajax_get_system_prompt', function()
        local agent = GetAgent();
        local prompt = agent:GetCachedSystemPrompt();
        wp_send_json({prompt = prompt or ""}, true);
    end)

    -----------------------------------------------------------
    -- Scene text context (lightweight, no screenshot)
    -----------------------------------------------------------
    add_action('wp_ajax_get_scene_context', function()
        local agent = GetAgent();
        local ctx = agent:GetSceneTextContext();
        wp_send_json({context = ctx or {}}, true);
    end)

    -----------------------------------------------------------
    -- TTS controls
    -----------------------------------------------------------
    add_action('wp_ajax_tts_stop', function()
        local agent = GetAgent();
        agent:StopTTS();
        wp_send_json({success = true}, true);
    end)

    add_action('wp_ajax_tts_clear_queue', function()
        local agent = GetAgent();
        agent:ClearTTSQueue();
        wp_send_json({success = true}, true);
    end)

    -----------------------------------------------------------
    -- Clear histories
    -----------------------------------------------------------
    add_action('wp_ajax_clear_chat', function()
        local agent = GetAgent();
        agent:ClearChatHistory();
        wp_send_json({success = true}, true);
    end)

    add_action('wp_ajax_clear_llm_history', function()
        local agent = GetAgent();
        agent:ClearLLMHistory();
        wp_send_json({success = true}, true);
    end)

    add_action('wp_ajax_clear_voice_history', function()
        local agent = GetAgent();
        agent:ClearVoiceHistory();
        wp_send_json({success = true}, true);
    end)

    add_action('wp_ajax_clear_scene_vision', function()
        local agent = GetAgent();
        agent:ClearSceneVisionHistory();
        wp_send_json({success = true}, true);
    end)

    add_action('wp_ajax_set_scene_vision_passive', function()
        local val = request:get("enabled");
        local enabled = (val == "1" or val == "true");
        NPL.load("(gl)script/apps/Aries/Creator/Game/Tasks/EasyBuilder/Copilot/SceneVisionManager.lua");
        local SVM = commonlib.gettable("MyCompany.Aries.Game.Tasks.EasyBuilder.Copilot.SceneVisionManager");
        SVM:SetPassiveMode(enabled);
        wp_send_json({success = true, passiveMode = SVM.passiveMode or false}, true);
    end)

    -----------------------------------------------------------
    -- Refresh copilots
    -----------------------------------------------------------
    add_action('wp_ajax_refresh_copilots', function()
        local agent = GetAgent();
        agent:RefreshCopilots();
        local copilots = agent:GetDiscoveredCopilots() or {};
        wp_send_json({success = true, count = #copilots}, true);
    end)

    -----------------------------------------------------------
    -- Debug mode toggle
    -----------------------------------------------------------
    add_action('wp_ajax_set_debug_enabled', function()
        local val = request:get("enabled");
        local enabled = (val == "1" or val == "true");
        local agent = GetAgent();
        agent:SetDebugEnabled(enabled);
        wp_send_json({success = true, debugEnabled = agent:IsDebugEnabled()}, true);
    end)

    -----------------------------------------------------------
    -- Observation mode
    -----------------------------------------------------------
    add_action('wp_ajax_set_observation_mode', function()
        local val = request:get("enabled");
        local enabled = (val == "1" or val == "true");
        local agent = GetAgent();
        agent:SetObservationMode(enabled);
        wp_send_json({success = true, observationMode = agent:IsObservationMode()}, true);
    end)

    add_action('wp_ajax_trigger_observation', function()
        local agent = GetAgent();
        agent:TriggerProactiveObservation();
        wp_send_json({success = true}, true);
    end)

    -----------------------------------------------------------
    -- Auto-speak (TTS)
    -----------------------------------------------------------
    add_action('wp_ajax_set_auto_speak', function()
        local val = request:get("enabled");
        local enabled = (val == "1" or val == "true");
        local agent = GetAgent();
        agent:SetAutoSpeakEnabled(enabled);
        wp_send_json({success = true, autoSpeakEnabled = agent:IsAutoSpeakEnabled()}, true);
    end)

    add_action('wp_ajax_get_tts_buffer', function()
        local agent = GetAgent();
        wp_send_json({buffer = agent:GetTTSBufferContent() or ""}, true);
    end)

    -----------------------------------------------------------
    -- Scene vision history
    -----------------------------------------------------------
    add_action('wp_ajax_get_scene_vision_history', function()
        local agent = GetAgent();
        local history = agent:GetSceneVisionHistory() or {};
        local maxEntries = tonumber(request:get("max")) or 20;
        local out = {};
        local startIdx = math.max(1, #history - maxEntries + 1);
        for i = startIdx, #history do
            local e = history[i];
            if e then
                out[#out+1] = {timestamp = e.timestamp, imageUrl = e.imageUrl, description = e.description, imagePath = e.imagePath};
            end
        end
        wp_send_json({entries = out, total = #history}, true);
    end)

    add_action('wp_ajax_get_latest_scene_vision', function()
        local agent = GetAgent();
        local e = agent:GetLatestSceneVision();
        if e then
            wp_send_json({entry = {timestamp = e.timestamp, imageUrl = e.imageUrl, description = e.description}}, true);
        else
            wp_send_json({entry = nil}, true);
        end
    end)

    -----------------------------------------------------------
    -- Voice history
    -----------------------------------------------------------
    add_action('wp_ajax_get_voice_history', function()
        local agent = GetAgent();
        local history = agent:GetVoiceHistory() or {};
        local maxEntries = tonumber(request:get("max")) or 20;
        local out = {};
        local startIdx = math.max(1, #history - maxEntries + 1);
        for i = startIdx, #history do
            local e = history[i];
            if e then
                out[#out+1] = {timestamp = e.timestamp, transcript = e.transcript, confidence = e.confidence};
            end
        end
        wp_send_json({entries = out, total = #history}, true);
    end)

    -----------------------------------------------------------
    -- Learning state persistence
    -----------------------------------------------------------
    add_action('wp_ajax_reset_learning_progress', function()
        local agent = GetAgent();
        agent:ResetLearningProgress();
        wp_send_json({success = true}, true);
    end)

    add_action('wp_ajax_save_learning_state', function()
        local agent = GetAgent();
        agent:SaveLearningState();
        wp_send_json({success = true}, true);
    end)

    add_action('wp_ajax_load_learning_state', function()
        local taskId = request:get("taskId");
        if taskId == "" then taskId = nil; end
        local agent = GetAgent();
        local ok = agent:LoadLearningState(taskId);
        wp_send_json({success = ok}, true);
    end)

    add_action('wp_ajax_clear_learning_state', function()
        local taskId = request:get("taskId");
        if taskId == "" then taskId = nil; end
        local agent = GetAgent();
        agent:ClearLearningState(taskId);
        wp_send_json({success = true}, true);
    end)

    add_action('wp_ajax_list_saved_tasks', function()
        local agent = GetAgent();
        local tasks = agent:ListSavedLearningTasks() or {};
        wp_send_json({tasks = tasks}, true);
    end)

    -----------------------------------------------------------
    -- Update interval
    -----------------------------------------------------------
    add_action('wp_ajax_set_update_interval', function()
        local interval = tonumber(request:get("interval"));
        if not interval or interval < 100 then
            wp_send_json({error = "invalid interval (min 100ms)"}, true);
            return;
        end
        local agent = GetAgent();
        agent:SetUpdateInterval(interval);
        wp_send_json({success = true, interval = interval}, true);
    end)

    -----------------------------------------------------------
    -- Context summary / scene changes
    -----------------------------------------------------------
    add_action('wp_ajax_get_context_summary', function()
        local agent = GetAgent();
        wp_send_json({summary = agent:GetContextHistorySummary() or ""}, true);
    end)

    add_action('wp_ajax_get_recent_scene_changes', function()
        local agent = GetAgent();
        wp_send_json({summary = agent:GetRecentSceneChangesSummary() or ""}, true);
    end)

    -----------------------------------------------------------
    -- System prompt management
    -----------------------------------------------------------
    add_action('wp_ajax_set_system_prompt', function()
        local prompt = request:get("prompt") or "";
        local agent = GetAgent();
        agent:SetSystemPrompt(prompt);
        wp_send_json({success = true}, true);
    end)

    add_action('wp_ajax_invalidate_system_prompt', function()
        local agent = GetAgent();
        agent:InvalidateSystemPromptCache();
        wp_send_json({success = true}, true);
    end)

    -----------------------------------------------------------
    -- UI tool queue
    -----------------------------------------------------------
    add_action('wp_ajax_clear_uitool_queue', function()
        local agent = GetAgent();
        agent:ClearUIToolQueue();
        wp_send_json({success = true}, true);
    end)

    -----------------------------------------------------------
    -- Last step inspection
    -----------------------------------------------------------
    add_action('wp_ajax_get_last_step', function()
        local agent = GetAgent();
        local ctx    = agent:GetLastStepContext();
        local result = agent:GetLastStepResult();
        wp_send_json({context = ctx, result = result}, true);
    end)

    return;
end
?>

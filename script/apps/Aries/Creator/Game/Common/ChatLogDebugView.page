</div>

<script>
(function(){
"use strict";
console.log("[ChatLogViewer] Script loaded");

// ======================== State ========================
var logDir = "temp/aichat_logs/";
var files = [];
var currentFile = null;
var sessions = [];
var currentSessionIdx = -1;
var totalFileSize = 0;

// ======================== DOM refs ========================
var $dateInput    = document.getElementById("date-input");
var $btnPrevDay   = document.getElementById("btn-prev-day");
var $btnNextDay   = document.getElementById("btn-next-day");
var $fileInfo     = document.getElementById("file-info");
var $sessionCount = document.getElementById("session-count");
var $sessionList  = document.getElementById("session-list");
var $content      = document.getElementById("cl-content");
var $contentWrap  = document.getElementById("content-wrap");
var $btnPrev         = document.getElementById("btn-prev");
var $btnNext         = document.getElementById("btn-next");
var $btnRefresh      = document.getElementById("btn-refresh");
var $btnDeleteBefore = document.getElementById("btn-delete-before");
var $searchBox       = document.getElementById("search-box");
var $btnVSCode       = document.getElementById("btn-vscode");
var $statusBar       = document.getElementById("status-bar");

console.log("[ChatLogViewer] DOM refs:", {
    dateInput: !!$dateInput, sessionList: !!$sessionList, content: !!$content,
    sidebar: !!document.getElementById("cl-sidebar"), app: !!document.getElementById("cl-app")
});

// ======================== Helpers ========================
function formatSize(n) {
    if (n > 1048576) return (n/1048576).toFixed(1) + " MB";
    if (n > 1024) return (n/1024).toFixed(0) + " KB";
    return n + " B";
}

function getLocalDateStr(d) {
    d = d || new Date();
    var pad = function(n){ return n < 10 ? "0" + n : n; };
    return d.getFullYear() + "-" + pad(d.getMonth() + 1) + "-" + pad(d.getDate());
}

function ajax(action, params, cb) {
    var qs = "action=" + action;
    if (params) for (var k in params) {
        if (params.hasOwnProperty(k)) qs += "&" + k + "=" + encodeURIComponent(params[k]);
    }
    console.log("[ChatLogViewer] AJAX ->", action, params);
    var xhr = new XMLHttpRequest();
    xhr.open("POST", "/ajax/raw?file=script/apps/Aries/Creator/Game/Common/ChatLogDebugView.page", true);
    xhr.setRequestHeader("Content-Type", "application/x-www-form-urlencoded");
    xhr.onreadystatechange = function(){
        if (xhr.readyState === 4) {
            console.log("[ChatLogViewer] AJAX <-", action, "status:", xhr.status, "len:", xhr.responseText.length);
            try { cb(JSON.parse(xhr.responseText)); }
            catch(e){ console.error("[ChatLogViewer] AJAX parse error:", e, xhr.responseText.substring(0,200)); cb({error: xhr.statusText || "parse error"}); }
        }
    };
    xhr.send(qs);
}

function shiftDate(dateStr, days) {
    var d = new Date(dateStr + "T00:00:00");
    d.setDate(d.getDate() + days);
    return getLocalDateStr(d);
}

// ======================== File list ========================
function loadFileList(cb) {
    console.log("[ChatLogViewer] loadFileList()");
    ajax("list_files", {}, function(data){
        files = data || [];
        console.log("[ChatLogViewer] Got", files.length, "files:", files.map(function(f){return f.date}));
        if (cb) cb();
    });
}

function findFileByDate(dateStr) {
    for (var i = 0; i < files.length; i++) {
        if (files[i].date === dateStr) return files[i];
    }
    return null;
}

// ======================== Date navigation ========================
function selectDate(dateStr) {
    console.log("[ChatLogViewer] selectDate:", dateStr);
    $dateInput.value = dateStr;
    var fileEntry = findFileByDate(dateStr);
    if (fileEntry) {
        $fileInfo.textContent = fileEntry.filename + " (" + formatSize(fileEntry.size) + ")";
        loadFileByName(fileEntry.filename);
    } else {
        console.log("[ChatLogViewer] No file for date:", dateStr);
        $fileInfo.textContent = "No log file for " + dateStr;
        currentFile = null;
        sessions = [];
        currentSessionIdx = -1;
        $sessionCount.textContent = "Sessions";
        $sessionList.innerHTML = '<div style="padding:12px;color:#6c7086;font-size:11px">No data for this date.</div>';
        $content.innerHTML = '<p style="color:#6c7086;text-align:center;padding:40px 0">No log file found for ' + dateStr + '.</p>';
        $statusBar.textContent = "";
        updateNavButtons();
    }
}

$dateInput.addEventListener("change", function(){
    selectDate($dateInput.value);
});

$btnPrevDay.addEventListener("click", function(){
    if ($dateInput.value) selectDate(shiftDate($dateInput.value, -1));
});

$btnNextDay.addEventListener("click", function(){
    if ($dateInput.value) selectDate(shiftDate($dateInput.value, 1));
});

// ======================== Load file & sessions ========================
function loadFileByName(fname) {
    console.log("[ChatLogViewer] loadFileByName:", fname, "currentFile:", currentFile);
    if (currentFile === fname) return;
    currentFile = fname;
    currentSessionIdx = -1;
    $sessionList.innerHTML = '<div style="text-align:center;padding:30px 0;color:#6c7086;font-size:13px">Scanning&hellip;</div>';
    $content.innerHTML = '<p style="color:#6c7086;text-align:center;padding:40px 0">Loading sessions&hellip;</p>';
    $statusBar.textContent = "";

    ajax("get_sessions", {logfile: fname}, function(data){
        if (data.error) {
            console.error("[ChatLogViewer] get_sessions error:", data.error);
            $sessionList.innerHTML = '<div style="padding:12px;color:#f38ba8;font-size:11px">' + data.error + '</div>';
            return;
        }
        sessions = data.sessions || [];
        totalFileSize = data.fileSize || 0;
        console.log("[ChatLogViewer] Got", sessions.length, "sessions, fileSize:", totalFileSize);
        $sessionCount.textContent = sessions.length + " Sessions";
        renderSessionList();

        if (sessions.length > 0) {
            selectSession(sessions.length - 1);
        } else {
            $content.innerHTML = '<div style="color:#6c7086;text-align:center;padding:40px 0">No sessions found in file.</div>';
        }
        $statusBar.textContent = sessions.length + " sessions | " + formatSize(totalFileSize);
    });
}

// Map from display index (newest-first) to file index
var sessionDisplayOrder = [];

function formatEpoch(epoch) {
    if (!epoch) return "";
    var d = new Date(epoch * 1000);
    var pad = function(n){ return n < 10 ? "0" + n : n; };
    return pad(d.getHours()) + ":" + pad(d.getMinutes()) + ":" + pad(d.getSeconds());
}

function renderSessionList() {
    console.log("[ChatLogViewer] renderSessionList:", sessions.length, "sessions");
    // Build display order: newest session first
    sessionDisplayOrder = [];
    for (var i = sessions.length - 1; i >= 0; i--) sessionDisplayOrder.push(i);

    var html = "";
    for (var di = 0; di < sessionDisplayOrder.length; di++) {
        var i = sessionDisplayOrder[di];
        var s = sessions[i];
        var timeStr = formatEpoch(s.epoch);
        var lineRange = "L" + s.line + "-L" + (s.endLine || "?");
        var statsStr = s.reqCount + "req / " + s.respCount + "resp";
        html += '<div class="session-item" style="padding:8px 12px;cursor:pointer;font-size:12px;border-bottom:1px solid #1e1e2e;border-left:3px solid transparent" data-idx="' + i + '">'
              + '<div style="font-weight:600;color:#89b4fa">'
              + '#' + s.id
              + (timeStr ? ' <span style="color:#f9e2af;font-weight:normal">: ' + timeStr + '</span>' : '')
              + '</div>'
              + '<div style="color:#6c7086;font-size:11px;margin-top:2px">' + statsStr + ' &middot; ' + lineRange + '</div>'
              + '</div>';
    }
    $sessionList.innerHTML = html || '<div style="padding:12px;color:#6c7086;font-size:11px">No sessions.</div>';

    var items = $sessionList.querySelectorAll(".session-item");
    console.log("[ChatLogViewer] Session items in DOM:", items.length);
    for (var di = 0; di < items.length; di++) {
        (function(item, fileIdx) {
            item.addEventListener("click", function(){ selectSession(fileIdx); });
            item.addEventListener("mouseenter", function(){ if(item.style.background !== "rgb(41, 70, 112)") item.style.background="#2a2a3e"; });
            item.addEventListener("mouseleave", function(){ if(item.style.background !== "rgb(41, 70, 112)") item.style.background=""; });
        })(items[di], sessionDisplayOrder[di]);
    }
}

// ======================== Select session ========================
function selectSession(idx) {
    if (idx < 0 || idx >= sessions.length) return;
    console.log("[ChatLogViewer] selectSession:", idx);
    currentSessionIdx = idx;
    updateNavButtons();

    // Highlight the correct item in the reversed display order
    var items = $sessionList.querySelectorAll(".session-item");
    for (var di = 0; di < items.length; di++) {
        if (sessionDisplayOrder[di] === idx) {
            items[di].style.background = "#294670";
            items[di].style.borderLeftColor = "#89b4fa";
            items[di].scrollIntoView({block:"nearest"});
        } else {
            items[di].style.background = "";
            items[di].style.borderLeftColor = "transparent";
        }
    }

    var s = sessions[idx];
    $content.innerHTML = '<div style="color:#6c7086;text-align:center;padding:40px 0">Loading session #' + s.id + '&hellip;</div>';
    $statusBar.textContent = "Loading session #" + s.id + "...";

    loadSessionText(s, function(text) {
        console.log("[ChatLogViewer] Session #" + s.id + " loaded, length:", text.length);
        renderMarkdownView(text, s);
        $statusBar.textContent = "Session #" + s.id + " | L" + s.line + "-L" + (s.endLine||"?") + " | " + formatSize(s.length);
    });
}

function loadSessionText(session, cb) {
    var chunkSize = 2 * 1024 * 1024;
    if (session.length <= chunkSize) {
        ajax("get_chunk", {logfile: currentFile, from: session.offset, length: session.length}, function(data){
            cb(data.text || "");
        });
    } else {
        var parts = [];
        var loaded = 0;
        var total = session.length;
        var loadNext = function() {
            var len = Math.min(chunkSize, total - loaded);
            ajax("get_chunk", {logfile: currentFile, from: session.offset + loaded, length: len}, function(data){
                parts.push(data.text || "");
                loaded += data.length;
                if (loaded < total) loadNext();
                else cb(parts.join(""));
            });
        };
        loadNext();
    }
}

// ======================== Markdown Renderer ========================
function escapeHtml(str) {
    return str.replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;");
}

// Render ~~~md content: plain text with [Image: URL] rendered as <img>
function renderMdContent(text) {
    text = text.replace(/\r/g, '');
    var parts = text.split(/(\[Image:[^\]]+\])/g);
    var out = [];
    for (var i = 0; i < parts.length; i++) {
        var m = parts[i].match(/^\[Image:\s*(.*?)\]$/);
        if (m) {
            var safeUrl = escapeHtml(m[1].trim());
            out.push('<img src="' + safeUrl + '" style="max-width:100%;max-height:400px;display:block;margin:6px 0;border-radius:4px"><div style="font-size:11px;color:#6c7086;word-break:break-all;margin-bottom:6px">' + safeUrl + '</div>');
        } else {
            out.push(escapeHtml(parts[i]));
        }
    }
    return out.join("");
}

function roleClass(role) {
    var r = role.toLowerCase();
    if (r === "system") return "role-system";
    if (r === "user") return "role-user";
    if (r.indexOf("assistant") !== -1) return r.indexOf("think") !== -1 ? "role-thinking" : "role-assistant";
    if (r.indexOf("tool") !== -1) return "role-tool";
    return "";
}

function entryTypeClass(typeStr) {
    if (!typeStr) return "";
    if (typeStr.indexOf("request") !== -1) return "type-request";
    if (typeStr.indexOf("response") !== -1) return "type-response";
    if (typeStr.indexOf("tool") !== -1) return "type-tool";
    if (typeStr.indexOf("summary") !== -1) return "type-summary";
    return "";
}

// Parse raw session text into rendered HTML
function renderMarkdownView(text, session) {
    // Split into blocks by --- separator, but only outside ~~~ fenced blocks
    var lines = text.replace(/\r/g, '').split("\n");
    var blocks = [];
    var currentBlock = [];
    var inFence = false;
    for (var i = 0; i < lines.length; i++) {
        var line = lines[i];
        if (/^~~~/.test(line)) {
            inFence = !inFence;
            currentBlock.push(line);
        } else if (!inFence && /^---\s*$/.test(line)) {
            // Block separator found outside fenced block
            blocks.push(currentBlock.join("\n"));
            currentBlock = [];
        } else {
            currentBlock.push(line);
        }
    }
    if (currentBlock.length > 0) blocks.push(currentBlock.join("\n"));

    var html = '';

    for (var bi = 0; bi < blocks.length; bi++) {
        var block = blocks[bi].trim();
        if (!block) continue;
        html += renderBlock(block);
    }

    $content.innerHTML = html || '<p style="color:#6c7086;text-align:center;padding:40px 0">Empty session.</p>';
    $contentWrap.scrollTop = 0;

    // Activate native <details> elements (they already work in browser)
    // Add copy-on-click to pre.code-block
    var pres = $content.querySelectorAll("pre.code-block");
    for (var i = 0; i < pres.length; i++) {
        pres[i].title = "Click to copy";
        pres[i].style.cursor = "pointer";
        pres[i].addEventListener("click", copyPre);
    }
}

function copyPre(e) {
    var text = e.currentTarget.textContent;
    try { navigator.clipboard.writeText(text); } catch(ex) {}
    var old = e.currentTarget.style.outline;
    e.currentTarget.style.outline = "1px solid #a6e3a1";
    setTimeout(function(){ e.currentTarget.style.outline = old; }, 600);
}

function renderBlock(block) {
    block = block.replace(/\r/g, '');
    var lines = block.split("\n");
    var li = 0;
    var html = '';

    function peek() { return li < lines.length ? lines[li] : null; }
    function next() { return li < lines.length ? lines[li++] : null; }

    // Detect entry type (from first metadata block)
    var typeStr = (block.match(/^type\s+:\s+(\w+)/m) || [])[1] || "";
    var blockClass = "entry-block " + entryTypeClass(typeStr);

    html += '<div class="' + blockClass + '">';

    while (li < lines.length) {
        var line = peek();
        if (line === null) break;

        // # Level-1 heading (Session title or Tool Call title)
        if (/^# /.test(line)) {
            next();
            html += '<h1 class="session-title">' + escapeHtml(line.slice(2)) + '</h1>';
            continue;
        }

        // ## Level-2 heading
        if (/^## /.test(line)) {
            next();
            html += '<h2 class="section-head">' + escapeHtml(line.slice(3)) + '</h2>';
            continue;
        }

        // ### Level-3 heading (message role)
        if (/^### /.test(line)) {
            next();
            var role = line.slice(4);
            html += '<h3 class="msg-role ' + roleClass(role) + '">' + escapeHtml(role) + '</h3>';
            continue;
        }

        // ~~~ fenced code block
        if (/^~~~/.test(line)) {
            var fence = next(); // consume opening ~~~
            var isJson = /json/i.test(fence) || typeStr === "";
            var isMeta = fence === "~~~";
            var isMd = /md/i.test(fence);
            var codeLines = [];
            while (li < lines.length && !/^~~~/.test(peek())) {
                codeLines.push(next());
            }
            if (li < lines.length) next(); // consume closing ~~~
            if (isMd) {
                html += '<div class="md-rendered">' + renderMdContent(codeLines.join("\n")) + '</div>';
            } else {
                var cls = "code-block" + (isMeta ? " meta-block" : "") + (/json/i.test(fence) ? " json-block" : "");
                html += '<pre class="' + cls + '">' + escapeHtml(codeLines.join("\n")) + '</pre>';
            }
            continue;
        }

        // ``` fenced code block (inside details)
        if (/^```/.test(line)) {
            var fence2 = next();
            var codeLines2 = [];
            while (li < lines.length && !/^```/.test(peek())) {
                codeLines2.push(next());
            }
            if (li < lines.length) next();
            var cls2 = "code-block" + (/json/i.test(fence2) ? " json-block" : "");
            html += '<pre class="' + cls2 + '">' + escapeHtml(codeLines2.join("\n")) + '</pre>';
            continue;
        }

        // <details> block – collect until </details> and render natively
        if (/^<details>/.test(line)) {
            var detLines = [];
            while (li < lines.length) {
                var dl = next();
                detLines.push(dl);
                if (/<\/details>/.test(dl)) break;
            }
            // Parse summary + body
            var detRaw = detLines.join("\n");
            var summaryMatch = detRaw.match(/<summary>([\s\S]*?)<\/summary>/);
            var summaryText = summaryMatch ? summaryMatch[1] : "Details";
            // Body: everything between </summary> and </details>, strip code fence if present
            var bodyRaw = detRaw.replace(/<details>/, "").replace(/<\/details>/, "").replace(/<summary>[\s\S]*?<\/summary>/, "").trim();
            // Render body lines through mini renderer (handles ``` blocks)
            var bodyHtml = "";
            var bLines = bodyRaw.split("\n");
            var bi2 = 0;
            while (bi2 < bLines.length) {
                var bl = bLines[bi2];
                if (/^```/.test(bl)) {
                    var f3 = bLines[bi2++];
                    var cl3 = [];
                    while (bi2 < bLines.length && !/^```/.test(bLines[bi2])) cl3.push(bLines[bi2++]);
                    if (bi2 < bLines.length) bi2++; // closing ```
                    bodyHtml += '<pre class="code-block' + (/json/i.test(f3) ? ' json-block' : '') + '">' + escapeHtml(cl3.join("\n")) + '</pre>';
                } else {
                    if (bl.trim()) bodyHtml += '<div class="det-body">' + escapeHtml(bl) + '</div>';
                    bi2++;
                }
            }
            html += '<details><summary>' + escapeHtml(summaryText) + '</summary>' + bodyHtml + '</details>';
            continue;
        }

        // Tool status lines: ⏳, ✓, ✗
        if (/^[⏳✓✗]/.test(line)) {
            next();
            var colored = line.replace(/^⏳/, '<span style="color:#f9e2af">⏳</span>')
                              .replace(/^✓/, '<span style="color:#a6e3a1">✓</span>')
                              .replace(/^✗/, '<span style="color:#f38ba8">✗</span>')
                              .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
                              .replace(/`([^`]+)`/g, '<code style="background:#2a2a3e;padding:0 3px;border-radius:3px">$1</code>');
            html += '<div class="tool-line">' + colored + '</div>';
            continue;
        }

        // blank or other lines – skip
        next();
    }

    html += '</div>';
    return html;
}

// ======================== Search (works on rendered content) ========================

// ======================== Navigation ========================
function updateNavButtons() {
    $btnPrev.disabled = currentSessionIdx <= 0;
    $btnNext.disabled = currentSessionIdx >= sessions.length - 1;
    $btnDeleteBefore.disabled = currentSessionIdx <= 0;
    $btnVSCode.disabled = currentSessionIdx < 0 || !currentFile;
}

$btnPrev.addEventListener("click", function(){ selectSession(currentSessionIdx - 1); });
$btnNext.addEventListener("click", function(){ selectSession(currentSessionIdx + 1); });

// ======================== Refresh ========================
$btnRefresh.addEventListener("click", function(){
    var fname = currentFile;
    if (!fname) {
        // no file loaded yet – just reload file list and pick today
        loadFileList(function(){
            var today = getLocalDateStr();
            if (!findFileByDate(today) && files.length > 0) today = files[0].date;
            selectDate(today);
        });
        return;
    }
    $statusBar.textContent = "Refreshing\u2026";
    // Reset so loadFileByName doesn't short-circuit
    currentFile = null;
    // Also refresh file-size info in sidebar
    loadFileList(function(){
        var entry = null;
        for (var i = 0; i < files.length; i++) {
            if (files[i].filename === fname) { entry = files[i]; break; }
        }
        if (entry) $fileInfo.textContent = entry.filename + " (" + formatSize(entry.size) + ")";
        loadFileByName(fname);
    });
});

// ======================== Delete Before ========================
// ======================== Open in VS Code ========================
function openInVSCode() {
    if (currentSessionIdx < 0 || !currentFile) return;
    var file = logDir + currentFile;
    var line = sessions[currentSessionIdx].line;
    ajax("open_in_vscode", {filepath: file, line: line}, function(data){
        if (data.error) alert("VSCode error: " + data.error);
    });
}

$btnVSCode.addEventListener("click", openInVSCode);

$btnDeleteBefore.addEventListener("click", function(){
    if (currentSessionIdx <= 0 || !currentFile) return;
    var s = sessions[currentSessionIdx];
    var count = currentSessionIdx; // sessions before current
    if (!confirm("Delete " + count + " session(s) before session #" + s.id + "?\nThis cannot be undone.")) return;
    $statusBar.textContent = "Deleting\u2026";
    $btnDeleteBefore.disabled = true;
    ajax("delete_before", {logfile: currentFile, from: s.offset}, function(data){
        if (data.error) {
            alert("Error: " + data.error);
            $statusBar.textContent = "Delete failed.";
            updateNavButtons();
            return;
        }
        $statusBar.textContent = "Deleted " + count + " session(s). Refreshing\u2026";
        var fname = currentFile;
        currentFile = null;
        loadFileList(function(){
            var entry = null;
            for (var i = 0; i < files.length; i++) {
                if (files[i].filename === fname) { entry = files[i]; break; }
            }
            if (entry) $fileInfo.textContent = entry.filename + " (" + formatSize(entry.size) + ")";
            loadFileByName(fname);
        });
    });
});

// ======================== Search ========================
var searchTimeout = null;
$searchBox.addEventListener("input", function(){
    if (searchTimeout) clearTimeout(searchTimeout);
    searchTimeout = setTimeout(doSearch, 300);
});
$searchBox.addEventListener("keydown", function(e){
    if (e.key === "Enter") { e.preventDefault(); doSearch(); }
});

function doSearch() {
    var query = $searchBox.value.trim();

    // Clear previous highlights
    var old = $content.querySelectorAll(".search-hl");
    for (var i = 0; i < old.length; i++) {
        var parent = old[i].parentNode;
        parent.replaceChild(document.createTextNode(old[i].textContent), old[i]);
        parent.normalize();
    }
    if (!query) {
        if (currentSessionIdx >= 0) {
            var s = sessions[currentSessionIdx];
            $statusBar.textContent = "Session #" + s.id + " | L" + s.line + "-L" + (s.endLine||"?") + " | " + formatSize(s.length);
        }
        return;
    }

    var walker = document.createTreeWalker($content, NodeFilter.SHOW_TEXT, null, false);
    var node, matches = [], queryLower = query.toLowerCase();
    while (node = walker.nextNode()) {
        var text = node.textContent, startIdx = 0, idx;
        while ((idx = text.toLowerCase().indexOf(queryLower, startIdx)) !== -1) {
            matches.push({node: node, idx: idx});
            startIdx = idx + 1;
        }
    }

    var limit = Math.min(matches.length, 1000);
    for (var i = limit - 1; i >= 0; i--) {
        var m = matches[i];
        var curIdx = m.node.textContent.toLowerCase().indexOf(queryLower, m.idx > 0 ? m.idx : 0);
        if (curIdx === -1) continue;
        try {
            var range = document.createRange();
            range.setStart(m.node, curIdx);
            range.setEnd(m.node, curIdx + query.length);
            var span = document.createElement("span");
            span.className = "search-hl";
            range.surroundContents(span);
        } catch(e) {}
    }

    var first = $content.querySelector(".search-hl");
    if (first) {
        first.classList.add("search-hl-current");
        first.scrollIntoView({behavior:"smooth", block:"center"});
    }
    $statusBar.textContent = (currentSessionIdx >= 0 ? "Session #" + sessions[currentSessionIdx].id + " | " : "") + matches.length + " matches" + (matches.length > 1000 ? " (showing 1000)" : "");
}

// ======================== Keyboard ========================
document.addEventListener("keydown", function(e){
    if ((e.ctrlKey || e.metaKey) && e.key === "f") {
        e.preventDefault();
        $searchBox.focus();
        $searchBox.select();
    }
    if (e.target.tagName !== "INPUT" && e.target.tagName !== "SELECT" && e.target.tagName !== "TEXTAREA") {
        if (e.key === "ArrowLeft" || e.key === "ArrowUp") { e.preventDefault(); selectSession(currentSessionIdx - 1); }
        if (e.key === "ArrowRight" || e.key === "ArrowDown") { e.preventDefault(); selectSession(currentSessionIdx + 1); }
    }
});

// ======================== postMessage API ========================
// Accepts { type: "refresh" } from the parent frame (TestBackgroundAgent test page).
// Reloads the file list and re-selects the currently-shown date so any new sessions
// appended since last load become visible, jumping to the latest session.
window.addEventListener("message", function(e) {
    if (!e.data || e.data.type !== "refresh") return;
    console.log("[ChatLogViewer] postMessage refresh received");
    // Clear the file-loaded guard so loadFileByName re-fetches even for same file
    currentFile = null;
    var dateToReload = $dateInput.value || getLocalDateStr();
    loadFileList(function() {
        if (!findFileByDate(dateToReload) && files.length > 0) {
            dateToReload = files[0].date;
        }
        selectDate(dateToReload);
    });
});

// ======================== Init ========================
console.log("[ChatLogViewer] Init: calling loadFileList");
loadFileList(function(){
    var today = getLocalDateStr();
    console.log("[ChatLogViewer] Files loaded. Today:", today, "Available:", files.map(function(f){return f.date}));
    if (!findFileByDate(today) && files.length > 0) {
        today = files[0].date;
    }
    selectDate(today);
});

})();
</script>

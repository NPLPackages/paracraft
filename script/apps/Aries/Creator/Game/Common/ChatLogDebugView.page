    <div id="cl-main">

        <!-- Toolbar -->
        <div style="display:flex;align-items:center;gap:8px;padding:6px 12px;background:#2a2a3e;border-bottom:1px solid #45475a;flex-shrink:0;flex-wrap:wrap">
            <button id="btn-prev" style="padding:3px 8px;background:rgba(137,180,250,.15);color:#89b4fa;border:none;border-radius:4px;font-size:11px;cursor:pointer" disabled>&laquo; Older</button>
            <button id="btn-next" style="padding:3px 8px;background:rgba(137,180,250,.15);color:#89b4fa;border:none;border-radius:4px;font-size:11px;cursor:pointer" disabled>Newer &raquo;</button>
            <div style="width:1px;height:18px;background:#45475a"></div>

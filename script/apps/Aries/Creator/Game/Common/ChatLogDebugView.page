<?npl
-- page layout (must be on top)
PAGE_NO_HEADER = true; 
PAGE_NO_SIDE_BAR = true;

--[[
Title: Chat Log Debug Viewer
Author: LiXizhi
Date: 2026/2/20
Desc: Web-based viewer for AI chat log files (.copilotmd) in temp/aichat_logs/.
  Supports very large files (10-50MB) via chunked reading.
  Features:
    - List all log files, browse by date
    - Parse sessions from a file, navigate by session
    - Auto-collapse <details> blocks
    - Default to current day's log
  AJAX endpoint: ajax/raw?file=script/apps/Aries/Creator/Game/Common/ChatLogDebugView.page&action=<action_name>
]]
if(not is_admin()) then
  exit("access denied")
end

local logDir = "temp/aichat_logs/";

if(is_ajax()) then

    ---------------------------------------------------------
    -- list_files: return all .copilotmd files with dates
    ---------------------------------------------------------
    add_action('wp_ajax_list_files', function()
        local files = {};
        local search_result = ParaIO.SearchFiles(logDir, "chat_*.copilotmd", "", 0, 1000, 0);
        local nCount = search_result:GetNumOfResult();
        for i = 0, nCount - 1 do
            local fname = search_result:GetItem(i);
            local year, month, day = fname:match("chat_(%d+)-(%d+)-(%d+)");
            if year then
                local fpath = logDir .. fname;
                local f = ParaIO.open(fpath, "r");
                local size = 0;
                if f:IsValid() then
                    size = f:GetFileSize();
                    f:close();
                end
                files[#files+1] = {
                    filename = fname,
                    date = year.."-"..month.."-"..day,
                    size = size,
                };
            end
        end
        -- sort descending by date
        table.sort(files, function(a,b) return a.date > b.date end);
        wp_send_json(files, true);
    end)

    ---------------------------------------------------------
    -- get_sessions: scan file for # Session lines, return index
    -- Reads only first bytes of each line – efficient for big files
    ---------------------------------------------------------
    add_action('wp_ajax_get_sessions', function()
        local fname = request:get("logfile") or "";
        local fpath = logDir .. fname;
        local f = ParaIO.open(fpath, "r");
        if not f:IsValid() then
            wp_send_json({error="file not found"}, true); return;
        end
        local fileSize = f:GetFileSize();
        local text = f:GetText(0, fileSize);
        f:close();

        local sessions = {};
        local pos = 1;
        local lineNum = 0;
        local currentSession = nil;
        local sectionType = nil; -- "request" or "response"
        local captureUserState = 0; -- 0=idle, 1=seen ### User heading, 2=inside user content fence
        local inToolCallSection = false;
        -- Scan for "# Session - XXXX" lines and extract metadata for grouping
        for line in text:gmatch("([^\n]*)\n?") do
            lineNum = lineNum + 1;
            local sessionId = line:match("^# Session %- (%d+)");
            if sessionId then
                currentSession = {
                    id = sessionId,
                    offset = pos - 1, -- byte offset (0-based)
                    line = lineNum,
                    epoch = 0,
                    reqCount = 0,
                    respCount = 0,
                    isFollowUp = false,
                    userPreview = "",
                    toolCallNames = {},
                };
                sessions[#sessions+1] = currentSession;
                sectionType = nil;
                captureUserState = 0;
                inToolCallSection = false;
            elseif currentSession then
                -- Detect # Tool Call sections
                local tcId = line:match("^# Tool Call %- (.+)");
                if tcId then
                    inToolCallSection = true;
                    sectionType = nil;
                end
                -- extract first epoch value seen in this session
                if currentSession.epoch == 0 then
                    local ep = line:match("^epoch%s+:%s+(%d+)");
                    if ep then currentSession.epoch = tonumber(ep); end
                end
                -- Section type tracking
                local t = line:match("^type%s+:%s+(%a+)");
                if t == "request" then
                    currentSession.reqCount = currentSession.reqCount + 1;
                    sectionType = "request";
                elseif t == "response" then
                    currentSession.respCount = currentSession.respCount + 1;
                    sectionType = "response";
                end
                -- Separator resets section
                if line:match("^%-%-%-") then
                    sectionType = nil;
                    captureUserState = 0;
                end
                -- Detect ### Tool in request section → this is a follow-up session
                if sectionType == "request" and line:match("^### Tool") then
                    currentSession.isFollowUp = true;
                end
                -- User text extraction state machine
                if sectionType == "request" and line:match("^### User") then
                    captureUserState = 1;
                elseif captureUserState == 1 and line:match("^~~~") then
                    captureUserState = 2;
                elseif captureUserState == 2 then
                    if line:match("^~~~") then
                        captureUserState = 0;
                    elseif currentSession.userPreview == "" then
                        local trimmed = line:match("^%s*(.-)%s*$");
                        if trimmed ~= "" and not trimmed:match("^%[Image:") then
                            currentSession.userPreview = trimmed:sub(1, 120);
                        end
                    end
                end
                -- Tool call name extraction from # Tool Call blocks
                if inToolCallSection then
                    local tcName = line:match("^name%s+:%s+(.+)");
                    if tcName then
                        local name = tcName:match("^%s*(.-)%s*$");
                        if name and name ~= "" then
                            table.insert(currentSession.toolCallNames, name);
                        end
                        inToolCallSection = false;
                    end
                end
                -- Extract tool names from inline markers: ⏳ **Calling** `tool_name`
                local inlineToolName = line:match("%*%*Calling%*%*%s*`([^`]+)`");
                if inlineToolName and currentSession then
                    local name = inlineToolName:match("^%s*(.-)%s*$");
                    if name and name ~= "" then
                        table.insert(currentSession.toolCallNames, name);
                    end
                end
            end
            pos = pos + #line + 1;
        end
        -- compute lengths and endLine
        for i = 1, #sessions do
            if i < #sessions then
                sessions[i].length = sessions[i+1].offset - sessions[i].offset;
                sessions[i].endLine = sessions[i+1].line - 1;
            else
                sessions[i].length = fileSize - sessions[i].offset;
                sessions[i].endLine = lineNum;
            end
        end
        -- Group sessions into messages (a message = user question + all follow-up tool-call sessions)
        local messages = {};
        local currentMsg = nil;
        for i = 1, #sessions do
            if not sessions[i].isFollowUp then
                currentMsg = {
                    id = sessions[i].id,
                    userPreview = sessions[i].userPreview,
                    epoch = sessions[i].epoch,
                    firstSessionIdx = i,
                    lastSessionIdx = i,
                    firstLine = sessions[i].line,
                    firstOffset = sessions[i].offset,
                    toolCallNames = {},
                    sessionCount = 1,
                };
                for _, tn in ipairs(sessions[i].toolCallNames) do
                    table.insert(currentMsg.toolCallNames, tn);
                end
                messages[#messages+1] = currentMsg;
            elseif currentMsg then
                currentMsg.lastSessionIdx = i;
                currentMsg.sessionCount = currentMsg.sessionCount + 1;
                for _, tn in ipairs(sessions[i].toolCallNames) do
                    table.insert(currentMsg.toolCallNames, tn);
                end
            else
                -- Orphaned follow-up, treat as standalone message
                currentMsg = {
                    id = sessions[i].id,
                    userPreview = sessions[i].userPreview ~= "" and sessions[i].userPreview or "(follow-up)",
                    epoch = sessions[i].epoch,
                    firstSessionIdx = i,
                    lastSessionIdx = i,
                    firstLine = sessions[i].line,
                    firstOffset = sessions[i].offset,
                    toolCallNames = {},
                    sessionCount = 1,
                };
                for _, tn in ipairs(sessions[i].toolCallNames) do
                    table.insert(currentMsg.toolCallNames, tn);
                end
                messages[#messages+1] = currentMsg;
            end
        end
        -- Compute total byte length and last line for each message
        for _, msg in ipairs(messages) do
            local lastSession = sessions[msg.lastSessionIdx];
            msg.totalLength = (lastSession.offset + lastSession.length) - msg.firstOffset;
            msg.lastLine = lastSession.endLine;
        end
        wp_send_json({fileSize = fileSize, sessions = sessions, messages = messages}, true);
    end)

    ---------------------------------------------------------
    -- get_chunk: return a byte range of the file
    -- params: file, from (byte offset), length
    ---------------------------------------------------------
    add_action('wp_ajax_get_chunk', function()
        local fname = request:get("logfile") or "";
        local fpath = logDir .. fname;
        local from = tonumber(request:get("from") or 0);
        local length = tonumber(request:get("length") or 65536);
        -- cap single read at 2MB
        if length > 2*1024*1024 then length = 2*1024*1024; end

        local f = ParaIO.open(fpath, "r");
        if not f:IsValid() then
            wp_send_json({error="file not found"}, true); return;
        end
        local fileSize = f:GetFileSize();
        local text = f:GetText(from, length);
        f:close();
        wp_send_json({from=from, length=#text, fileSize=fileSize, text=text}, true);
    end)

    ---------------------------------------------------------
    -- delete_before: truncate file, keeping only from a given byte offset
    -- params: file, from (byte offset of the session to keep from)
    ---------------------------------------------------------
    add_action('wp_ajax_delete_before', function()
        local fname = request:get("logfile") or "";
        -- basic safety: only allow chat_*.copilotmd inside logDir
        if not fname:match("^chat_%d+%-%d+%-%d+%.copilotmd$") then
            wp_send_json({error="invalid filename"}, true); return;
        end
        local fpath = logDir .. fname;
        local from = tonumber(request:get("from") or 0);
        if from <= 0 then
            wp_send_json({error="nothing to delete"}, true); return;
        end
        local f = ParaIO.open(fpath, "r");
        if not f:IsValid() then
            wp_send_json({error="file not found"}, true); return;
        end
        local fileSize = f:GetFileSize();
        local kept = f:GetText(from, fileSize - from);
        f:close();
        local fw = ParaIO.open(fpath, "w");
        if not fw:IsValid() then
            wp_send_json({error="cannot write file"}, true); return;
        end
        fw:WriteString(kept);
        fw:close();
        wp_send_json({ok=true, deleted=from, newSize=#kept}, true);
    end)

    ---------------------------------------------------------
    -- open_in_vscode: open a file at a given line in VS Code
    -- params: file (path, relative or absolute), line
    ---------------------------------------------------------
    add_action('wp_ajax_open_in_vscode', function()
        local file = request:get("filepath") or "";
        local line = tonumber(request:get("line")) or 1;
        if file == "" then
            wp_send_json({error="no file specified"}, true); return;
        end
        -- Resolve relative paths to game root
        if not file:match("^[A-Za-z]:[/\\]") and not file:match("^/") then
            local root = ParaIO.GetWritablePath();
            if root and root ~= "" then
                file = root .. file;
            end
        end
        local cmd = 'code --goto "' .. file .. ':' .. line .. '"';
        LOG.std(nil, "info", "ChatLogDebugView", "VSCode cmd: %s", cmd);
        os.execute(cmd);
        wp_send_json({success=true, cmd=cmd}, true);
    end)

    return;
end
PAGE_NO_SIDE_BAR = true;
PAGE_NO_HEADER = true;
?>
<script src="https://cdn.keepwork.com/keepwork/cdn/tailwindcss@3.4.16.js"></script>

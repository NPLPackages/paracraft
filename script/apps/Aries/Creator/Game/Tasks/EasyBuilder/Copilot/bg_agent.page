        <button id="obsBtn" onclick="Agent.toggleObservationMode()" class="px-2.5 py-1 text-xs rounded bg-card text-txt border border-border hover:bg-border">Obs: OFF</button>
        <button id="autoSpeakBtn" onclick="Agent.toggleAutoSpeak()" class="px-2.5 py-1 text-xs rounded bg-card text-txt border border-border hover:bg-border">&#x1F50A; AutoSpeak: OFF</button>
        <button id="visionPassiveBtn" onclick="Agent.toggleVisionPassive()" class="px-2.5 py-1 text-xs rounded bg-card text-txt border border-border hover:bg-border">&#x1F4F7; Vision: Active</button>
        <button onclick="Agent.triggerObservation()" class="px-2.5 py-1 text-xs rounded bg-card text-txt border border-border hover:bg-border">&#x1F441; Observe</button>
        <button onclick="Agent.clearUIToolQueue()" class="px-2.5 py-1 text-xs rounded bg-card text-txt border border-border hover:bg-border">&#x1F9F9; UIQ</button>
        <span id="wsBadge" class="ml-auto px-2 py-0.5 rounded-full text-xs font-semibold bg-surface text-muted" title="WebSocket connection status">WS: &#x25CF; connecting</span>
        <button id="btn-open-logs" onclick="toggleLogDrawer()" class="px-2.5 py-1 text-xs rounded bg-card text-txt border border-border hover:bg-border" title="Open Chat Log Viewer (slide in)">&#x1F4DC; Logs</button>
    </div>

    <!-- Main 3-column -->
    <div class="flex flex-1 gap-2 min-h-0">

        <!-- Left Column -->
        <div class="w-80 flex-shrink-0 flex flex-col gap-2">
            <!-- Status -->
            <div class="bg-card border border-border rounded-lg flex flex-col">
                <div class="px-2.5 py-1.5 text-xs font-semibold text-blue border-b border-border">Status</div>
                <div id="statusPanel" class="p-2 text-xs space-y-0.5"></div>
            </div>
            <!-- Left Tabs -->

<!-- ==================== APP ==================== -->
<div id="cl-app">

    <!-- ===== LEFT SIDEBAR ===== -->
    <div id="cl-sidebar">

        <!-- Date picker header -->
        <div style="padding:10px;border-bottom:1px solid #45475a;flex-shrink:0">
            <div style="font-size:13px;font-weight:600;color:#a6adc8;margin-bottom:6px">&#128196; Chat Logs</div>
            <div style="display:flex;align-items:center;gap:4px">
                <button id="btn-prev-day" style="padding:3px 8px;background:rgba(137,180,250,.15);color:#89b4fa;border:none;border-radius:4px;font-size:11px;cursor:pointer" title="Previous day">&laquo;</button>
                <input type="date" id="date-input" style="flex:1;background:#1a1a2e;color:#cdd6f4;border:1px solid #45475a;border-radius:4px;padding:3px 6px;font-size:11px" />
                <button id="btn-next-day" style="padding:3px 8px;background:rgba(137,180,250,.15);color:#89b4fa;border:none;border-radius:4px;font-size:11px;cursor:pointer" title="Next day">&raquo;</button>
            </div>

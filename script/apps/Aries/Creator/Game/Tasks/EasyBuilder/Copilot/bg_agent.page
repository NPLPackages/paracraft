        <span class="w-px h-5 bg-border mx-1"></span>
        <span id="stateBadge" class="px-2 py-0.5 rounded-full text-xs font-semibold uppercase"></span>
        <span class="w-px h-5 bg-border mx-1"></span>
        <button onclick="Agent.play()" class="px-2.5 py-1 text-xs rounded bg-blue text-base font-medium hover:opacity-85">&#9654; Play</button>
        <button onclick="Agent.pause()" class="px-2.5 py-1 text-xs rounded bg-card text-txt border border-border hover:bg-border">&#10074;&#10074; Pause</button>
